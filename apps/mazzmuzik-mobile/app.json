{
  "expo": {
    "name": "MazzMuziK",
    "slug": "mazzmuzik",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090D0A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fun.mazzmuzik.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "fun.mazzmuzik.app",
      "backgroundColor": "#090D0A"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-audio"
    ]
  }
}
