{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MazzMuziK",
  "version": "1.0.0",
  "identifier": "ai.mazz.mazzmuzik",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MazzMuziK",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/node",
      "binaries/deno",
      "binaries/fpcalc",
      "binaries/bgutil-provider"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
