{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "mazzmuzik-desktop": {
      "root": "apps/mazzmuzik-desktop",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "mazzmuzik-server",
          "format": "url",
          "env": "MAZZMUZIK_SERVER_URL"
        }
      ]
    },
    "mazzmuzik-server": {
      "root": ".",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/api/deezer/:match*",
      "destination": "https://api.deezer.com/:match*"
    },
    {
      "source": "/api/ytmusic/:match*",
      "destination": "https://music.youtube.com/:match*"
    },
    {
      "source": "/api/lyrics/:match*",
      "destination": "https://lrclib.net/:match*"
    },
    {
      "source": "/rest/(.*)",
      "destination": {
        "service": "mazzmuzik-server"
      }
    },
    {
      "source": "/api/server/(.*)",
      "destination": {
        "service": "mazzmuzik-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "mazzmuzik-desktop"
      }
    }
  ]
}
