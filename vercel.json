{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/deezer/:match*",
      "destination": "https://api.deezer.com/:match*"
    },
    {
      "source": "/api/ytmusic/(.*)",
      "destination": "/api/ytmusic"
    },
    {
      "source": "/api/lyrics/:match*",
      "destination": "https://lrclib.net/:match*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
